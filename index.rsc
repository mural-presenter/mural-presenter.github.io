2a:["$","div",null,{"className":"lifecycle-details","children":[["$","div","ground",{"className":"lifecycle-detail","data-mode":"ground","children":[["$","small",null,{"children":"01 Prepare"}],["$","h3",null,{"children":"Shared knowledge, plans, and assets"}],["$","p",null,{"children":"Research gathers evidence; the Orchestrator adopts knowledge and plans page briefs, notes, and design rules. Asset prepares and inspects assets. Together these form shared deck state; preparation can overlap and continue as needed."}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Owners"}],["$","dd",null,{"children":"Orchestrator · Research · Asset"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Input"}],["$","dd",null,{"children":"Request · Source materials"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Output"}],["$","dd",null,{"children":"Knowledge · Blueprint · Inspected assets"}]]}]]}]]}],["$","div","plan",{"className":"lifecycle-detail","data-mode":"plan","children":[["$","small",null,{"children":"02 Assign"}],["$","h3",null,{"children":"Delegate around joint decisions"}],["$","p",null,{"children":"In the paper’s animal-compass illustration, Sun and Star pages have separate Single Owners. Calibration and Comparison share a Group Owner because direction conventions and factual conditions need joint decisions."}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Owners"}],["$","dd",null,{"children":"Orchestrator"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Input"}],["$","dd",null,{"children":"Shared state · Cross-page dependencies"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Output"}],["$","dd",null,{"children":"Page units → Responsible Owners"}]]}]]}]]}],["$","div","author",{"className":"lifecycle-detail","data-mode":"author","children":[["$","small",null,{"children":"03 Author"}],["$","h3",null,{"children":"Ready units proceed in parallel"}],["$","p",null,{"children":"Owners author their pages from shared knowledge, plans, and assets. A Group Owner coordinates Calibration and Comparison in one context. Independent units can proceed in parallel; cross-unit issues return to the Orchestrator."}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Owners"}],["$","dd",null,{"children":"Single / Group Owners"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Input"}],["$","dd",null,{"children":"Page units · Shared state"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Output"}],["$","dd",null,{"children":"Page HTML · Speaker notes"}]]}]]}]]}],["$","div","review",{"className":"lifecycle-detail","data-mode":"review","children":[["$","small",null,{"children":"04 Refine"}],["$","h3",null,{"children":"Review the deck. Resume its Owners."}],["$","p",null,{"children":"Owners write, render, and inspect their pages to build the current checked deck. The Orchestrator reviews pages and notes, updates shared state, and resumes the responsible Owners for revisions. Passing review leads to delivery."}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Owners"}],["$","dd",null,{"children":"Orchestrator · Original Owners"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Input"}],["$","dd",null,{"children":"Current deck · Findings · Edit requests"}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Output"}],["$","dd",null,{"children":"Checked pages · Assets · Notes"}]]}]]}]]}]]}]
