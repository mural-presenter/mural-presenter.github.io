  addEventListener('pagereveal', event => {
    if (!animated || !event.viewTransition) {
      delete root.dataset.languageNative;
      event.viewTransition?.skipTransition();
      return;
    }
    root.dataset.languageNative = 'true';
    const finish = () => {
      delete root.dataset.languageNative;
      delete root.dataset.languageTransition;
      root.style.removeProperty('--language-veil-start');
    };
    event.viewTransition.finished.then(finish, finish);
  });
