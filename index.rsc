13:["$","section",null,{"className":"paper-introduction section-shell","id":"overview","aria-labelledby":"summary-title","children":[["$","div",null,{"className":"paper-introduction-title","children":[["$","h2",null,{"id":"summary-title","children":["MuralPresenter: ","Dependency-Aware Multi-Agent Authoring for Long-Horizon Presentations"]}],false]}],["$","div",null,{"className":"paper-introduction-copy","children":[["$","p",null,{"className":"paper-tldr","children":"Shared knowledge, blueprints, and assets coordinate the deck. Persistent Slide Owners carry related slides through generation, inspection, and revision; quality-aware trajectory distillation teaches effective authoring actions."}],["$","div",null,{"className":"paper-home-abstract","aria-labelledby":"abstract-title","children":[["$","h3",null,{"id":"abstract-title","children":"Abstract"}],[["$","p","Long-horizon presentation authoring requires carrying content into slides while maintaining consistency throughout generation and revision. Existing workflows primarily organize authoring stages, often overlooking how production responsibility should be assigned. We propose MuralPresenter, which splits slide production among local Owners under shared deck coordination. Each Owner retains responsibility through generation, inspection, and revision. To enhance authoring capabilities, we introduce quality-aware trajectory distillation, combining high-quality trajectory selection with selective supervision to learn effective authoring behaviors. MuralPresenter-27B achieves the highest Overall score on PresentBench and Content accuracy on SlidesGen-Bench, two public benchmarks.",{"children":"Long-horizon presentation authoring requires carrying content into slides while maintaining consistency throughout generation and revision. Existing workflows primarily organize authoring stages, often overlooking how production responsibility should be assigned. We propose MuralPresenter, which splits slide production among local Owners under shared deck coordination. Each Owner retains responsibility through generation, inspection, and revision. To enhance authoring capabilities, we introduce quality-aware trajectory distillation, combining high-quality trajectory selection with selective supervision to learn effective authoring behaviors. MuralPresenter-27B achieves the highest Overall score on PresentBench and Content accuracy on SlidesGen-Bench, two public benchmarks."}]]]}],["$","nav",null,{"className":"paper-reading-links","aria-label":"Research guide","children":[["$","a",null,{"href":"#animal-case","children":["The compass case"," ↗"]}],["$","a",null,{"href":"#method","children":["Method"," ↗"]}],["$","a",null,{"href":"#benchmark","children":"ThreadEval ↗"}],["$","a",null,{"href":"#results","children":["Results"," ↗"]}]]}]]}]]}]
