16:["$","section",null,{"className":"evaluation-exhibit section-shell","id":"training","aria-labelledby":"training-title","children":[["$","div",null,{"className":"evaluation-exhibit-head","children":[["$","h2",null,{"id":"training-title","children":"Keep the context. Supervise the new actions."}],["$","p",null,{"children":"The same history can appear in many later execution segments. Selective action supervision retains that context without repeatedly training on historical actions. We train 9B and 27B models on 9,000 quality-filtered segments from 686 source records, spanning four collaborating roles."}]]}],["$","div",null,{"className":"training-counts","children":[["$","div","Slide",{"children":[["$","strong",null,{"children":"7,516"}],["$","span",null,{"children":"Slide"}]]}],["$","div","Research",{"children":[["$","strong",null,{"children":"827"}],["$","span",null,{"children":"Research"}]]}],["$","div","Orchestrator",{"children":[["$","strong",null,{"children":"450"}],["$","span",null,{"children":"Orchestrator"}]]}],["$","div","Image",{"children":[["$","strong",null,{"children":"207"}],["$","span",null,{"children":"Image"}]]}]]}],["$","details",null,{"className":"home-details","children":[["$","summary",null,{"children":"Supervision policies and controls"}],["$","div",null,{"className":"evaluation-ledger","children":[["$","article","Full",{"children":[["$","h3",null,{"children":"Full"}],["$","p",null,{"children":"Supervise historical and current assistant actions."}]]}],["$","article","Global Selective",{"children":[["$","h3",null,{"children":"Global Selective"}],["$","p",null,{"children":"Keep history as input but mask its assistant loss; supervise current target actions across roles."}]]}],["$","article","Role-wise Selective",{"children":[["$","h3",null,{"children":"Role-wise Selective"}],["$","p",null,{"children":"Apply that mask only to Slide segments as an ablation condition."}]]}]]}],["$","div",null,{"className":"research-note","children":[["$","span",null,{"children":"Controls"}],["$","p",null,{"children":"The 9,000 units are execution segments, not tasks or decks. Historical imports and separately collected artifact-first recovery trajectories are excluded. Within each backbone, record membership, order, packing, and hyperparameters are fixed. Training updates the language backbone while freezing the vision encoder and merger."}]]}]]}]]}]
17:["$","section",null,{"className":"evaluation-exhibit section-shell","id":"benchmark","aria-labelledby":"benchmark-title","children":[["$","div",null,{"className":"evaluation-exhibit-head","children":[["$","h2",null,{"id":"benchmark-title","children":"ThreadEval: trace the process. Inspect the deck."}],["$","p",null,{"children":"Final artifacts show what a system delivers; process evidence helps locate omissions and handoff problems. ThreadEval uses task-specific rubrics to trace requirements through intermediate artifacts and execution logs, reporting Process and Final separately."}]]}],["$","p",null,{"className":"benchmark-scale","children":"35 Chinese / English tasks · 6 domains · 20–40 slides per deck"}],["$","div",null,{"className":"evaluation-ledger","children":[["$","article","01",{"children":[["$","h3",null,{"children":"Process · Where were requirements fulfilled?"}],["$","p",null,{"children":"Trace intermediate artifacts and execution logs through research and transfer (R), executable plans (P), asset preparation and use (I), and page realization and inspection (S). In the compass case: did research findings enter the plan and reach the assigned Owners?"}]]}],["$","article","02",{"children":[["$","h3",null,{"children":"Final · Did the deck deliver?"}],["$","p",null,{"children":"Inspect eight Deck dimensions and five Page dimensions. In the compass case: were all 40 slides delivered, including the requested comparison table?"}]]}]]}],["$","div",null,{"className":"evaluation-relationship","children":[["$","p",null,{"children":[["$","strong",null,{"children":"How is Final calculated?"}],["$","span",null,{"children":"Deck-level quality contributes 70%; page-level quality contributes 30%. Process is reported separately, without a combined overall score."}]]}],["$","p",null,{"className":"evaluation-formula","children":["Final = ",["$","b",null,{"children":"0.70"}]," × Deck + ",["$","b",null,{"children":"0.30"}]," × Page"]}]]}],["$","figure",null,{"className":"paper-diagram paper-diagram-threadeval","children":[["$","div",null,{"className":"paper-diagram-scroll","tabIndex":0,"role":"region","aria-label":"ThreadEval: process evidence and final quality","children":["$","a",null,{"className":"paper-diagram-image","href":"/figures/threadeval-horizontal-20261005.webp","target":"_blank","rel":"noreferrer","aria-label":"ThreadEval: process evidence and final quality — Open full-resolution figure in a new tab","children":["$","img",null,{"src":"/figures/threadeval-horizontal-20261005.webp","alt":"ThreadEval: process evidence and final quality","width":4960,"height":1172,"loading":"lazy","decoding":"async"}]}]}],["$","figcaption",null,{"children":[["$","span",null,{"children":[false,"ThreadEval: process evidence and final quality"]}],["$","a",null,{"href":"/figures/threadeval-horizontal-20261005.webp","target":"_blank","rel":"noreferrer","children":["View full size"," ↗"]}]]}],["$","p",null,{"className":"paper-diagram-hint","children":"Task & rubrics → Process evaluation → Final evaluation → Judging & scores. Scroll horizontally on narrow screens."}]]}],["$","p",null,{"className":"benchmark-bridge","children":"Generation is also evaluated on PresentBench and SlidesGen-Bench, with five-turn editing on DECKBench Task 2. Scores and comparison conditions follow in the leaderboard."}]]}]
