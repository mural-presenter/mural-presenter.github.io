13:["$","section",null,{"className":"ownership-exhibit","id":"task","aria-labelledby":"ownership-title","children":[["$","div",null,{"className":"section-shell ownership-exhibit-copy","children":[["$","span",null,{"className":"section-label is-light","children":"The authoring challenge"}],["$","h2",null,{"id":"ownership-title","children":"A whole deck, or one page at a time?"}],["$","p",null,{"children":"Facts, visual conventions, and narrative must remain consistent across a deck. Whole-deck authoring accumulates execution history; per-slide authoring must coordinate across separate contexts."}]]}],["$","div",null,{"className":"section-shell","id":"showcase","children":["$","div",null,{"className":"topology-explorer","children":[[["$","input","dependencies",{"className":"explorer-control topology-control is-dependencies","type":"radio","data-language-choice":"topology-dependencies","name":"topology-en","id":"topology-en-dependencies","defaultChecked":true,"aria-label":"Dependencies"}],["$","input","sequential",{"className":"explorer-control topology-control is-sequential","type":"radio","data-language-choice":"topology-sequential","name":"topology-en","id":"topology-en-sequential","defaultChecked":false,"aria-label":"Whole-deck"}],["$","input","parallel",{"className":"explorer-control topology-control is-parallel","type":"radio","data-language-choice":"topology-parallel","name":"topology-en","id":"topology-en-parallel","defaultChecked":false,"aria-label":"Per-slide"}]],["$","div",null,{"className":"explorer-tabs paint-tabs","aria-label":"Explore authoring trade-offs","children":[["$","label","dependencies",{"data-mode":"dependencies","htmlFor":"topology-en-dependencies","children":[["$","span",null,{"children":["0",1]}],"Dependencies"]}],["$","label","sequential",{"data-mode":"sequential","htmlFor":"topology-en-sequential","children":[["$","span",null,{"children":["0",2]}],"Whole-deck"]}],["$","label","parallel",{"data-mode":"parallel","htmlFor":"topology-en-parall