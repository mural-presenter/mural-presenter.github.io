14:["$","section",null,{"className":"method-exhibit section-shell responsibility-solution","id":"method","aria-labelledby":"solution-title","children":[["$","div",null,{"className":"method-exhibit-head","children":[["$","div",null,{"children":[["$","span",null,{"className":"section-label","children":"The MURAL approach"}],["$","h2",null,{"id":"solution-title","children":"Shared deck state. Responsibility where it belongs."}]]}],["$","p",null,{"children":"The Orchestrator maintains deck plans and assignments; Research and Image supply evidence and assets. With those inputs shared, unit-adaptive assignment gives independent pages to Single Owners and pages needing joint adjustment to one Group Owner. Ownership persists through authoring, inspection, and revision."}]]}],["$","div",null,{"className":"role-case-layout","children":[["$","figure",null,{"className":"paper-diagram paper-diagram-roles-tools","children":[["$","div",null,{"className":"paper-diagram-scroll","tabIndex":"$undefined","role":"$undefined","aria-label":"$undefined","children":["$","a",null,{"className":"paper-diagram-image","href":"/figures/roles-tools-20261010.webp","target":"_blank","rel":"noreferrer","aria-label":"Roles and tools in MuralPresenter — Open full-resolution figure in a new tab","children":["$","img",null,{"src":"/figures/roles-tools-20261010.webp","alt":"Roles and tools in MuralPresenter","width":2400,"height":4832,"loading":"lazy","decoding":"async"}]}]}],["$","figcaption",null,{"children":[["$","span",null,{"children":["Fig. 2 · ","Roles and tools in MuralPresenter"]}],["$","a",null,{"href":"/figures/roles-tools-20261010.webp","target":"_blank","rel":"noreferrer","children":["View full size"," ↗"]}]]}],false]}],["$","$L21",null,{"language":"en"}]]}],["$","p",null,{"className":"method-scope","children":"Groups address joint decisions that remain after information is shared. Shared style, sources, or adjacency alone do not define a group."}]]}]
