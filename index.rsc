1b:["$","section",null,{"className":"evaluation-exhibit section-shell results-analysis","id":"results","aria-labelledby":"results-title","children":[["$","div",null,{"className":"evaluation-exhibit-head","children":["$","h2",null,{"id":"results-title","children":"What do the results tell us?"}]}],["$","div",null,{"className":"result-findings","children":[["$","article","Generation",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["01"," / ","Generation"]}],["$","h3",null,{"children":"Content gains do not imply uniform visual gains."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"The 9B and 27B models reach 90.21% and 94.92% Content on SlidesGen-Bench. The 27B model scores 8.42 on colorfulness-based Engagement. It does not lead Total Aesthetics, and Harmony falls relative to its untuned backbone."}],["$","p",null,{"className":"finding-scope","children":"The 27B model leads the listed systems on PresentBench Overall at 72.6. Published systems retain their source protocols; this comparison does not establish equal computational cost."}]]}]]}],["$","article","Process and delivery",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["02"," / ","Process and delivery"]}],["$","h3",null,{"children":"Trace where requirements are lost between plans and slides."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"On ThreadEval, the 27B model scores 79.04 on presentation Overall and 87.75 on Process, the highest Process score in the main comparison. For 9B, planning (P) reaches 83.60, while asset use (I) and slide realization (S) reach only 36.13 and 33.60, revealing a gap between planning and delivery."}],["$","p",null,{"className":"finding-scope","children":"The archive includes formal and diagnostic evaluations and must be interpreted separately from strictly validated ablations."}]]}]]}],["$","article","Multi-turn editing",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["03"," / ","Multi-turn editing"]}],["$","h3",null,{"children":"Five completed edits test continuity of the artifact."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"The 27B model completes five edits on all 294 tasks. Trained and untuned models improve mean metrics over their initial decks; between-model confidence intervals include zero."}],["$","p",null,{"className":"finding-scope","children":"Each turn imports previous artifacts into a fresh workspace. This does not establish a benefit from persistent Owner history."}]]}]]}],["$","article","Responsibility",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["04"," / ","Responsibility"]}],["$","h3",null,{"children":"Distributing production helps; extra grouping gains remain uncertain."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"On 35 production tasks with fixed preparation and tools, per-page and adaptive ownership gain 2.40 and 2.49 Overall points over whole-deck ownership, with greater recorded workload."}],["$","p",null,{"className":"finding-scope","children":"Adaptive ownership exceeds per-page ownership by only 0.09 points (95% CI [−1.35, 1.60]); no extra advantage is established. Usage includes continuations, excludes shared preparation, and is a lower bound when failed-call usage is missing."}]]}]]}],["$","article","Supervision",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["05"," / ","Supervision"]}],["$","h3",null,{"children":"Selective supervision reduces recorded input workload."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"Versus Full, Global Selective records 38.0% fewer input tokens and 30.2% fewer turns. Its +2.20 Overall difference (95% CI [−0.22, 4.57]) means neither a quality gain nor non-inferiority is established."}],["$","p",null,{"className":"finding-scope","children":"Global exceeds Vanilla by 4.02 Overall points, but also uses more total tokens and turns. Usage counts cover completed runs; elapsed time and monetary cost were not measured."}]]}]]}]]}]]}]
