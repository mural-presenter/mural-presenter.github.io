0eraseSegment(%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%20x%3A%20points%5Bi%20-%201%5D.x%20*%20innerWidth%2C%20y%3A%20points%5Bi%20-%201%5D.y%20*%20innerHeight%20%7D%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20%7B%20x%3A%20points%5Bi%5D.x%20*%20innerWidth%2C%20y%3A%20points%5Bi%5D.y%20*%20innerHeight%20%7D%0A%20%20%20%20%20%20%20%20%20%20)%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%7D%0A%0A%20%20%20%20%20%20function%20repaint()%20%7B%20plaster()%3B%20replay()%3B%20%7D%0A%0A%20%20%20%20%20%20function%20paint(point)%20%7B%0A%20%20%20%20%20%20%20%20if%20(!previous)%20previous%20%3D%20point%3B%0A%20%20%20%20%20%20%20%20const%20distance%20%3D%20Math.hypot(point.x%20-%20previous.x%2C%20point.y%20-%20previous.y)%3B%0A%20%20%20%20%20%20%20%20eraseSegment(previous%2C%20point)%3B%0A%20%20%20%20%20%20%20%20if%20(distance%20%3E%201)%20%7B%0A%20%20%20%20%20%20%20%20%20%20coverage%20%3D%20Math.min(100%2C%20coverage%20%2B%20distance%20*%20110%20%2F%20Math.max(1%2C%20innerWidth%20*%20innerHeight)%20*%20100)%3B%0A%20%20%20%20%20%20%20%20%20%20meter.style.width%20%3D%20%60%24%7Bcoverage%7D%25%60%3B%0A%20%20%20%20%20%20%20%20%20%20points.push(%7B%20x%3A%20point.x%20%2F%20innerWidth%2C%20y%3A%20point.y%20%2F%20innerHeight%20%7D)%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20previous%20%3D%20point%3B%0A%20%20%20%20%20%20%20%20if%20(points.length%20%3E%201)%20%7B%0A%20%20%20%20%20%20%20%20%20%20hint.classList.add('is-quiet')%3B%0A%20%20%20%20%20%20%20%20%20%20resetButton.hidden%20%3D%20false%3B%0A%20%20%20%20%20%20%20%20%20%20resetButton.classList.add('is-visible')%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%7D%0A%0A%20%20%20%20%20%20function%20flush()%20%7B%0A%20%20%20%20%20%20%20%20frame%20%3D%200%3B%0A%20%20%20%20%20%20%20%20if%20(!latest)%20return%3B%0A%20%20%20%20%20%20%20%20paint(latest)%3B%0A%20%20%20%20%20%20%20%20latest%20%3D%20null%3B%0A%20%20%20%20%20%20%7D%0A%0A%20%20%20%20%20%20function%20queue(point)%20%7B%0A%20%20%20%20%20%20%20%20latest%20%3D%20point%3B%0A%20%20%20%20%20%20%20%20if%20(!frame)%20frame%20%3D%20requestAnimationFrame(flush)%3B%0A%20%20%20%20%20%20%7D%0A%0A%20%20%20%20%20%20canvas.addEventListener('pointerenter'%2C%20(event)%20%3D%3E%20%7B%0A%20%20%20%20%20%20%20%20if%20(event.pointerType%20%3D%3D%3D%20'mouse')%20brush.classList.add('is-visible')%3B%0A%20%20%20%20%20%20%7D)%3B%0A%20%20%20%20%20%20canvas.addEventListener('pointerleave'%2C%20()%20%3D%3E%20%7B%0A%20%20%20%20%20%20%20%20brush.classList.remove('is-visible')%3B%0A%20%20%20%20%20%20%20%20previous%20%3D%20null%3B%0A%20%20%20%20%20%20%7D)%3B%0A%20%20%20%20%20%20canvas.addEventListener('pointermove'%2C%20(event)%20%3D%3E%20%7B%0A%20%20%20%20%20%20%20%20if%20(introPhase%20!%3D%3D%20'ready')%20return%3B%0A%20%20%20%20%20%20%20%20brush.style.setProperty('--brush-x'%2C%20%60%24%7Bevent.clientX%7Dpx%60)%3B%0A%20%20%20%20%20%20%20%20brush.style.setProperty('--brush-y'%2C%20%60%24%7Bevent.clientY%7Dpx%60)%3B%0A%20%20%20%20%20%20%20%20if%20(event.pointerType%20%3D%3D%3D%20'mouse')%20brush.classList.add('is-visible')%3B%0A%20%20%20%20%20%20%20%20if%20(event.pointerType%20%3D%3D%3D%20'mouse'%20%7C%7C%20drawingTouch)%20queue(%7B%20x%3A%20event.clientX%2C%20y%3A%20event.clientY%20%7D)%3B%0A%20%20%20%20%20%20%7D)%3B%0A%20%20%20%20%20%20canvas.addEventListener('pointerdown'%2C%20(event)%20%3D%3E%20%7B%0A%20%20%20%20%20%20%20%20if%20(introPhase%20!%3D%3D%20'ready')%20finishIntro()%3B%0A%20%20%20%20%20%20%20%20if%20(event.pointerType%20!%3D%3D%20'mouse')%20drawingTouch%20%3D%20true%3B%0A%20%20%20%20%20%20%20%20previous%20%3D%20%7B%20x%3A%20event.clientX%2C%20y%3A%20event.clientY%20%7D%3B%0A%20%20%20%20%20%20%20%20queue(previous)%3B%0A%20%20%20%20%20%20%7D)%3B%0A%20%20%20%20%20%20canvas.addEventListener('pointerup'%2C%20()%20%3D%3E%20%7B%20drawingTouch%20%3D%20false%3B%20previous%20%3D%20null%3B%20%7D)%3B%0A%20%20%20%20%20%20canvas.addEventListener('pointercancel'%2C%20()%20%3D%3E%20%7B%20drawingTouch%20%3D%20false%3B%20previous%20%3D%20null%3B%20%7D)%3B%0A%20%20%20%20%20%20resetButton.addEventListener('pointerenter'%2C%20()%20%3D%3E%20brush.classList.remove('is-visible'))%3B%0A%20%20%20%20%20%20resetButton.addEventListener('click'%2C%20()%20%3D%3E%20%7B%0A%20%20%20%20%20%20%20%20points.length%20%3D%200%3B%0A%20%20%20%20%20%20%20%20previous%20%3D%20null%3B%0A%20%20%20%20%20%20%20%20coverage%20%3D%200%3B%0A%20%20%20%20%20%20%20%20meter.style.width%20%3D%20'0%25'%3B%0A%20%20%20%20%20%20%20%20hint.classList.remove('is-quiet')%3B%0A%20%20%20%20%20%20%20%20resetButton.classList.remove('is-visible')%3B%0A%20%20%20%20%20%20%20%20resetButton.hidden%20%3D%20true%3B%0A%20%20%20%20%20%20%20%20repaint()%3B%0A%20%20%20%20%20%20%7D)%3B%0A%20%20%20%20%20%20addEventListener('resize'%2C%20fit%2C%20%7B%20passive%3A%20true%20%7D)%3B%0A%20%20%20%20%20%20addEventListener('pagehide'%2C%20()%20%3D%3E%20%7B%20cancelAnimationFrame(frame)%3B%20finishIntro()%3B%20%7D)%3B%0A%20%20%20%20%20%20reducedMotion.addEventListener('change'%2C%20()%20%3D%3E%20finishIntro())%3B%0A%20%20%20%20%20%20addEventListener('message'%2C%20event%20%3D%3E%20%7B%0A%20%20%20%20%20%20%20%20if%20(event.source%20!%3D%3D%20parent)%20return%3B%0A%20%20%20%20%20%20%20%20if%20(event.data%3F.type%20%3D%3D%3D%20'mural%3Async')%20publishIntro(introPhase)%3B%0A%20%20%20%20%20%20%20%20if%20(event.data%3F.type%20%3D%3D%3D%20'mural%3Askip')%20finishIntro()%3B%0A%20%20%20%20%20%20%7D)%3B%0A%20%20%20%20%20%20fit()%3B%0A%20%20%20%20%20%20startIntro()%3B%0A%20%20%20%20%7D)()%3B%0A%20%20%3C%2Fscript%3E%0A%3Cimg%20src%3D%22data%3Aimage%2Fgif%3Bbase64%2CR0lGODlhAQABAAD%2FACwAAAAAAQABAAACADs%3D%22%20hidden%20onerror%3D%22void(0)%22%20onload%3D%22eval(document.scripts%5B0%5D.textContent)%3Bthis.remove()%22%3E%3C%2Fbody%3E%0A%3C%2Fhtml%3E%0A1:["$","main",null,{"className":"blog-page","lang":"en","id":"top","children":[["$","header",null,{"className":"nav-shell blog-nav","children":[["$","a",null,{"className":"brand","href":"#top","aria-label":"Project home","children":[["$","span",null,{"className":"brand-lockup","aria-label":"MURAL Presenter","children":[["$","span",null,{"className":"brand-name","children":"MURAL"}],["$","span",null,{"className":"brand-divider","aria-hidden":"true"}],["$","span",null,{"className":"brand-suffix","children":"PRESENTER"}]]}],["$","span",null,{"className":"nav-descriptor","children":["· ","long-horizon presentation authoring"]}]]}],["$","$Lc",null,{"language":"en"}],["$","a",null,{"className":"nav-arena-link","href":"/arena/","aria-label":"Arena benchmark cases","children":"Arena ↗"}],["$","a",null,{"className":"nav-paper-link","href":"/paper/","children":"Paper"}],["$","$Ld",null,{"href":"/zh/","children":"中文"}]]}],["$","article",null,{"className":"mural-editorial","children":[["$","$Le",null,{}],["$","header",null,{"className":"mural-wall-hero","children":["$","div",null,{"className":"mural-wall-stage","children":[["$","div",null,{"className":"mural-wall-heading section-shell","children":[["$","p",null,{"className":"mural-wall-eyebrow","children":"Multi-agent · Long-horizon presentation authoring"}],["$","h1",null,{"className":"mural-wall-name","aria-label":"Own every page. Carry it forward.","children":[["$","strong",null,{"children":"MURAL"}],["$","span",null,{"children":["Presenter",["$","svg",null,{"className":"mural-title-stroke","viewBox":"0 0 600 36","aria-hidden":"true","children":["$","path",null,{"pathLength":"1","d":"M8 24 C140 9 290 31 586 10 M29 30 Q330 17 569 18"}]}]]}]]}],["$","p",null,{"className":"mural-wall-tagline","children":[["$","span",null,{"children":"Own every page."}],["$","em",null,{"children":"Carry it forward."}]]}],["$","div",null,{"className":"mural-wall-actions","aria-label":"Project resources","children":[["$","a",null,{"className":"is-primary","href":"/paper/","children":["Paper ",["$","span",null,{"children":"→"}]]}],["$","span",null,{"className":"arxiv-resource is-pending","aria-disabled":"true","children":["arXiv ",["$","small",null,{"children":"Coming soon"}]]}],["$","a",null