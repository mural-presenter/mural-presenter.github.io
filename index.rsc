19:["$","section",null,{"className":"evaluation-exhibit section-shell results-analysis","id":"results","aria-labelledby":"results-title","children":[["$","div",null,{"className":"evaluation-exhibit-head","children":["$","h2",null,{"id":"results-title","children":"What do the results tell us?"}]}],["$","div",null,{"className":"result-findings","children":[["$","article","Generation",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["01"," / ","Generation"]}],["$","h3",null,{"children":"Content gains do not imply uniform visual gains."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"The 9B and 27B models reach 90.21% and 94.92% Content on SlidesGen-Bench. The 27B model scores 8.42 on colorfulness-based Engagement. It does not lead Total Aesthetics, and Harmony falls relative to its untuned backbone."}],["$","p",null,{"className":"finding-scope","children":"The 72.6 PresentBench score includes score-conditioned output selection. Generation and recovery opportunities differ, so it does not establish a fixed-budget SFT gain or improved reliability."}]]}]]}],["$","article","Process and delivery",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["02"," / ","Process and delivery"]}],["$","h3",null,{"children":"Better execution need not mean a better final deck."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"In the ThreadEval archive, Process improves by 9.13 points for 9B and 2.05 for 27B. For 27B, research transfer rises from 78.27 to 87.94, while plan realization and inspection falls from 89.26 to 76.03. An aggregate gain can coexist with weaker stages."}],["$","p",null,{"className":"finding-scope","children":"The archive includes formal and diagnostic evaluations and must be interpreted separately from strict Final-only supervision results."}]]}]]}],["$","article","Multi-turn editing",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["03"," / ","Multi-turn editing"]}],["$","h3",null,{"children":"Five completed edits test continuity of the artifact."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"The 27B model completes five edits on all 294 tasks. Trained and untuned models improve mean metrics over their initial decks; between-model confidence intervals include zero."}],["$","p",null,{"className":"finding-scope","children":"Each turn imports previous artifacts into a fresh workspace. This does not establish a benefit from persistent Owner history."}]]}]]}],["$","article","Responsibility",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["04"," / ","Responsibility"]}],["$","h3",null,{"children":"Distributing production helps; extra grouping gains remain uncertain."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"On 35 production tasks with fixed preparation and tools, per-page and adaptive ownership gain 2.40 and 2.49 Final points over whole-deck ownership, with greater recorded workload."}],["$","p",null,{"className":"finding-scope","children":"Adaptive ownership exceeds per-page ownership by only 0.09 points (95% CI [−1.35, 1.60]); no extra advantage is established. Usage includes continuations, excludes shared preparation, and is a lower bound when failed-call usage is missing."}]]}]]}],["$","article","Supervision",{"children":[["$","div",null,{"children":[["$","span",null,{"children":["05"," / ","Supervision"]}],["$","h3",null,{"children":"Selective supervision reduces recorded input workload."}]]}],["$","div",null,{"children":[["$","p",null,{"children":"Versus Full, Global Selective records 38.0% fewer input tokens and 30.2% fewer turns. Its +2.20 Final difference (95% CI [−0.22, 4.57]) means neither a quality gain nor non-inferiority is established."}],["$","p",null,{"className":"finding-scope","children":"Global exceeds Vanilla by 4.02 Final points, but also uses more total tokens and turns. Historical search, image backends, and quotas differ, preventing a pure training-effect interpretation. Completed-chain accounting is not full-campaign cost or elapsed time."}]]}]]}]]}]]}]
