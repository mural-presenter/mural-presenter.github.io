2:T441,(() => {
  const root = document.documentElement;
  const read = () => JSON.parse(sessionStorage.getItem('mural-language-transfer') || 'null');
  const transfer = read();
  const animated = transfer?.animate && transfer.path === location.pathname && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (animated) {
    root.dataset.languageTransition = 'entering';
    if (transfer.native) root.dataset.languageNative = 'true';
  }
  addEventListener('pageswap', event => {
    const next = read();
    if (event.viewTransition && !next?.animate) event.viewTransition.skipTransition();
  });
  addEventListener('pagereveal', event => {
    if (!animated || !event.viewTransition) {
      delete root.dataset.languageNative;
      event.viewTransition?.skipTransition();
      return;
    }
    root.dataset.languageNative = 'true';
    const finish = () => {
      delete root.dataset.languageNative;
      delete root.dataset.languageTransition;
      root.style.removeProperty('--language-veil-start');
    };
    event.viewTransition.finished.then(finish, finish);
  });
